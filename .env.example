# Copy this file to .env and fill in your own values. Never commit .env.
#
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql://postgres:your_password_here@localhost:5432/smart_parking

# Separate database used by pytest (it is wiped and rebuilt by the tests!)
TEST_DATABASE_URL=postgresql://postgres:your_password_here@localhost:5432/smart_parking_test

# Any long random string. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-long-random-string

FLASK_DEBUG=1

# Show one-click sample-account logins on the login page (1 = on, 0 = off)
DEMO_LOGINS=1
FLASK_PORT=5000

# Public-demo mode: every visitor gets a private copy of the sample data that is
# thrown away when they refresh the page. 1 = on, 0 = off. When this line is
# absent it is on only on Vercel (which sets VERCEL=1).
# DEMO_SANDBOX=0
